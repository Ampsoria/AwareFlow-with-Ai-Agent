# Loaded automatically from the project root; process environment wins.
# Demo identity selector is the prototype's only authentication provider.
APP_MODE=demo
AUTH_PROVIDER=demo_selector
APP_TIMEZONE=Asia/Bangkok
APP_BASE_URL=http://localhost:8501
# Use a NEW root/database when switching mock <-> connected providers.
# Blank/omitted paths choose var/demo for mock or var/connected for any live LLM/search.
# DATA_ROOT=./var/my-dataset
# DATABASE_PATH=./var/my-dataset/awareflow.sqlite3

# mock | openai | openai_compatible | ollama | anthropic | gemini | company
# See docs/PROVIDERS.md and examples/env/*.env.example.
# LLM_ENDPOINT is the base URL, NOT /chat/completions, /api/chat or :generateContent.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_ENDPOINT=
# Universal key overrides the selected provider's named key when non-empty.
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# json_schema | json | text for compatible/Ollama/Gemini; all outputs validated locally.
LLM_OUTPUT_MODE=json
LLM_MAX_OUTPUT_TOKENS=6000
# Localhost HTTP is supported automatically. Enable explicitly for a known HTTP LAN server.
LLM_ALLOW_INSECURE_HTTP=false
# Company adapter factory must implement the company's documented protocol.
COMPANY_ADAPTER_FACTORY=
COMPANY_API_ENDPOINT=
COMPANY_CREDENTIAL_ENV=COMPANY_API_TOKEN
COMPANY_API_TOKEN=
# mock | tavily; SEARCH_ENDPOINT is the full search URL, not an API base URL.
SEARCH_PROVIDER=mock
SEARCH_ENDPOINT=
SEARCH_API_KEY=
PROVIDER_TIMEOUT_SECONDS=45

# Blank creates a persistent local secret with file mode 0600.
APP_SIGNING_SECRET=
LINK_TTL_HOURS=168

# Both switches and an allowlisted recipient are required for SMTP.
EMAIL_TRANSPORT=preview
EMAIL_REAL_SEND_ENABLED=false
EMAIL_TEST_ALLOWLIST=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=120
# Run scheduler CLI continuously or use the explicit tick button.
# Internal policy/reporting contacts are configured in admin; never invented.

# Agent limits per job attempt; no automatic publication or email tool.
AGENT_MAX_STEPS=12
AGENT_MAX_SEARCHES=5
AGENT_MAX_DRAFTS=3
